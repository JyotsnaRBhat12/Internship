{
  "info": {
    "_postman_id": "f36bc802-88fd-4593-ad8f-9f03e4deb328",
    "name": "User Notes_Updated",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" },
    { "key": "token", "value": "" },
    { "key": "category_name", "value": "Personal" },
    { "key": "tag1_name", "value": "urgent" },
    { "key": "tag2_name", "value": "backend" },
    { "key": "search_keyword", "value": "Flask" },
    { "key": "category_id", "value": "" },
    { "key": "tag1_id", "value": "" },
    { "key": "tag2_id", "value": "" },
    { "key": "note_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Register returns 201 or 409', function () {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser1\",\n  \"password\": \"test1234\"\n}"
        },
        "url": "{{base_url}}/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Login returns access token', function () {",
              "  pm.expect(json.access_token).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('token', json.access_token);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser1\",\n  \"password\": \"test1234\"\n}"
        },
        "url": "{{base_url}}/login"
      }
    },
    {
      "name": "Create Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create category status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Category id exists', function () {",
              "  pm.expect(json.id).to.exist;",
              "});",
              "pm.collectionVariables.set('category_id', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{category_name}}\"\n}"
        },
        "url": "{{base_url}}/categories"
      }
    },
    {
      "name": "Get Categories",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get categories status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Categories array exists', function () {",
              "  pm.expect(json.categories).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/categories"
      }
    },
    {
      "name": "Create Tag 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create tag 1 status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Tag 1 id exists', function () {",
              "  pm.expect(json.id).to.exist;",
              "});",
              "pm.collectionVariables.set('tag1_id', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{tag1_name}}\"\n}"
        },
        "url": "{{base_url}}/tags"
      }
    },
    {
      "name": "Create Tag 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create tag 2 status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Tag 2 id exists', function () {",
              "  pm.expect(json.id).to.exist;",
              "});",
              "pm.collectionVariables.set('tag2_id', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{tag2_name}}\"\n}"
        },
        "url": "{{base_url}}/tags"
      }
    },
    {
      "name": "Get Tags",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get tags status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Tags array exists', function () {",
              "  pm.expect(json.tags).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/tags"
      }
    },
    {
      "name": "Create Note",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create note status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Note id exists', function () {",
              "  pm.expect(json.note_id).to.exist;",
              "});",
              "pm.collectionVariables.set('note_id', json.note_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Finish Flask assignment today\",\n  \"category_id\": {{category_id}},\n  \"tags\": [{{tag1_id}}, {{tag2_id}}]\n}"
        },
        "url": "{{base_url}}/notes"
      }
    },
    {
      "name": "Get Notes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get notes status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Notes array exists', function () {",
              "  pm.expect(json.notes).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/notes"
      }
    },
    {
      "name": "Filter Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Filter by category status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Filtered notes array exists', function () {",
              "  pm.expect(json.notes).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/notes?category={{category_name}}"
      }
    },
    {
      "name": "Filter Tag",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Filter by tag status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Filtered notes array exists', function () {",
              "  pm.expect(json.notes).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/notes?tag={{tag1_name}}"
      }
    },
    {
      "name": "Search",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Search status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Search result has notes array', function () {",
              "  pm.expect(json.notes).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/notes?search={{search_keyword}}"
      }
    },
    {
      "name": "Update Note",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update note status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Updated note content\"\n}"
        },
        "url": "{{base_url}}/notes/{{note_id}}"
      }
    },
    {
      "name": "Delete Note",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete note status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/notes/{{note_id}}"
      }
    },
    {
      "name": "Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/logout"
      }
    }
  ]
}
